{
  "name": "@jmonzone/design",
  "version": "0.1.0",
  "description": "Shared UI components for jmonzone's apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/ && cp -R src/fonts dist/",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "preversion": "npm run typecheck && npm run build",
    "postversion": "git push --follow-tags"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
