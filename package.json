{
  "name": "@jmonzone/design",
  "version": "0.1.0",
  "description": "Shared React UI components and styles for my apps: buttons, and a three.js card pack opener.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pack-opener": {
      "types": "./dist/types/pack-opener/index.d.ts",
      "import": "./dist/pack-opener.js"
    },
    "./pack-opener/react": {
      "types": "./dist/types/pack-opener/react/index.d.ts",
      "import": "./dist/pack-opener-react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/ && cp -R src/fonts dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "preversion": "npm run typecheck && npm test && npm run build",
    "postversion": "git push --follow-tags"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.161.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/three": "~0.161.2",
    "three": "~0.161.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
